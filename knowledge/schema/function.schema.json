{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excamera.local/schema/function.schema.json",
  "title": "Exanima native function research and contract record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "build_sha256", "symbol", "role", "abi", "thread", "memory", "relationships", "evidence", "states", "research", "generation"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "pattern": "^exanima(\\.[a-z0-9_]+)+$"},
    "build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_name", "rva", "va", "body", "classification"],
      "properties": {
        "provider_name": {"type": "string"},
        "rva": {"$ref": "#/$defs/address"},
        "va": {"$ref": "#/$defs/address"},
        "body": {"type": ["object", "null"]},
        "classification": {"type": ["object", "null"]}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "state"],
      "properties": {
        "summary": {"type": "string"},
        "state": {"enum": ["hypothesis", "reviewed", "validated_runtime", "rejected"]}
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_signature", "calling_convention", "parameters", "return"],
      "properties": {
        "status": {"enum": ["unknown", "hypothesized", "reviewed"]},
        "provider_signature": {"type": ["string", "null"]},
        "calling_convention": {"type": ["string", "null"]},
        "parameters": {"type": ["array", "null"], "items": {"type": "object"}},
        "return": {}
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "details"],
      "properties": {
        "status": {"enum": ["unknown", "hypothesized", "reviewed", "validated_runtime"]},
        "details": {"type": ["string", "null"]}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reads", "writes", "lifetime"],
      "properties": {
        "status": {"enum": ["unknown", "hypothesized", "reviewed", "validated_runtime"]},
        "reads": {"type": ["array", "null"], "items": {"type": "object"}},
        "writes": {"type": ["array", "null"], "items": {"type": "object"}},
        "lifetime": {"type": ["string", "null"]}
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callers", "callees", "limitations"],
      "properties": {
        "callers": {"type": "array", "items": {"$ref": "#/$defs/native_ref"}},
        "callees": {"type": "array", "items": {"$ref": "#/$defs/native_ref"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence_id", "operation", "provider", "analysis_profile_digest"],
        "properties": {
          "kind": {"const": "rea_ghidra_function_dossier"},
          "evidence_id": {"type": "string", "pattern": "^ev_[0-9a-f]{64}$"},
          "operation": {"const": "analyze_function"},
          "provider": {"$ref": "#/$defs/provider"},
          "analysis_profile_digest": {"type": ["string", "null"]}
        }
      }
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["observed_static", "reviewed_static", "byte_validated", "observed_runtime", "validated_runtime", "hypothesis", "rejected"]}
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_eligible", "reason"],
      "properties": {
        "runtime_eligible": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "native_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "name"],
      "properties": {
        "address": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]}
      }
    }
  }
}
