# Set default behavior to automatically handle line endings
* text=auto

# Windows C/C++ source, headers, inlines and docs enforce CRLF
*.c text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.inl text eol=crlf
*.asm text eol=crlf
*.txt text eol=crlf
*.md text eol=crlf
*.json text eol=crlf
*.toml text eol=crlf

# Git and CI workflows enforce LF
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.dll binary
*.lib binary
*.obj binary
